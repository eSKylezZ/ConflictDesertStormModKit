#
# The hull's three textures change; the main gun is a separate model (the Abrams' gun in VEHWPNS.TXT / WEAPS.TXT)
# and keeps the game's colours. The wreck gets a skin too ("damaged texture <slot>").

id        = DESERT_ABRAMS
